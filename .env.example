# ResQNet Backend Configuration & Database Connection

PORT=5050

# MongoDB Connection String:
# Option A (Local MongoDB): mongodb://localhost:27017/resqnet
# Option B (MongoDB Atlas Cloud): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/resqnet?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/resqnet

# JWT Security Secret
JWT_SECRET=resqnet_odisha_disaster_jwt_secret_key_2026

# Frontend API origin. Override this when deploying the frontend against another backend.
VITE_API_URL=http://localhost:5050

# Comma-separated frontend origins allowed to call the backend.
CLIENT_URLS=http://localhost:3000,http://localhost:5173,https://resqnet-1-kaxz.onrender.com
